@model IEnumerable<FoodHubProject2.Models.Order>

@{
    ViewData["Title"] = "Моите поръчки";
}

<div class="container mt-4">

    <h2>Моите поръчки</h2>

    <hr />

    <table class="table table-striped">

        <thead class="table-dark">

            <tr>
                <th>Номер</th>
                <th>Дата</th>
                <th>Статус</th>
                <th>Обща сума</th>
                <th>Действие</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var order in Model)
            {
                <tr>

                    <td>@order.Id</td>

                    <td>@order.OrderDate</td>

                    <td>@order.Status</td>

                    <td>@order.TotalAmount лв.</td>

                    <td>
                        <a asp-controller="Order"
                           asp-action="Track"
                           asp-route-id="@order.Id"
                           class="btn btn-primary btn-sm">
                            Проследи
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
